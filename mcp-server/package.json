{
  "name": "studiquo-mcp-server",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "smoke": "node src/smoke.ts",
    "test": "node --test \"src/*.test.ts\"",
    "test:ai": "node --test src/ai.test.ts",
    "security:sast": "python3 ../security/sast/run.py",
    "security:sast:test": "python3 -m unittest discover -s ../security/sast -p \"test_*.py\"",
    "security:dast": "node ../security/dast/run.ts",
    "security:dast:contracts": "node ../security/dast/run.ts --contracts-only",
    "security:dast:test": "node --test ../security/dast/*.test.ts",
    "security:sast:rules": "python3 ../security/sast/test_rules.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/hashes": "2.4.0",
    "@simplewebauthn/server": "^13.3.3",
    "jose": "^5.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "wrangler": "^4.151.1"
  }
}
