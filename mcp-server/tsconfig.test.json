// Type-checks the tests together with src. The tests build fake Envs and read JSON
// bodies without declaring their shapes, so test-types/loose.d.ts relaxes
// Response.json(). The source itself is checked, strictly, by tsconfig.json.
{
  "extends": "./tsconfig.json",
  // main types the tests strictly (`Untyped`, src/test-env.ts). The RAG tests of claude/rag-ts are still
  // written loosely (no parameter types), so strict is off here until they are typed (tracked in Notion).
  // src itself stays strict through tsconfig.json.
  "compilerOptions": { "strict": false },
  "include": ["src/**/*", "test-types/*.d.ts"],
  "exclude": []
}
