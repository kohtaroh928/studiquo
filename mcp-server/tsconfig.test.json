// Type-checks the tests together with src. The tests build fake Envs and read JSON
// bodies without declaring their shapes, so test-types/loose.d.ts relaxes
// Response.json(). The source itself is checked, strictly, by tsconfig.json.
{
  "extends": "./tsconfig.json",
  // Strict, as tsconfig.json is for src. Where a test reads data without declaring its shape (JSON from a
  // response, rows from the in-memory SQLite, the arguments of a fake binding), it says so with `Untyped`
  // (src/test-env.ts) instead of leaving a parameter implicitly `any`.
  "compilerOptions": { "strict": true },
  "include": ["src/**/*", "test-types/*.d.ts"],
  "exclude": []
}
