# Xcode project is generated by XcodeGen from project.yml — run
# `xcodegen generate` after cloning instead of committing the generated file.
/*.xcodeproj/

# Build products
build/
build_out/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Xcode user-specific state (not generated by XcodeGen)
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Local scratch files, not part of the repo
*.MP4
*.mov
*.mp4
.env

# Security reports contain internal findings; upload only sanitized summaries.
/security-reports/
/security/sast/__pycache__/
/security/dast/__pycache__/

# Local Workers runtime cache (test data is never persisted).
/.wrangler/
Configuration/Staging.local.xcconfig
